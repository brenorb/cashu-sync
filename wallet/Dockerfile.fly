FROM node:22.14.0 AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG CASHU_SYNC_MINT_URL
ARG CASHU_SYNC_RELAY_URL
ENV PUBLIC_PATH=/ \
    CASHU_SYNC_MINT_URL=${CASHU_SYNC_MINT_URL} \
    CASHU_SYNC_RELAY_URL=${CASHU_SYNC_RELAY_URL} \
    CASHU_SYNC_ALLOW_INSECURE_LOOPBACK=false
RUN npm run build:pwa

FROM nginx:1.27-alpine
COPY --from=build /app/dist/pwa /usr/share/nginx/html
EXPOSE 80
