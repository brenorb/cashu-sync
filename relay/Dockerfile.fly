FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/cashu-sync-relay ./cmd/cashu-sync-relay

FROM alpine:3.22
RUN adduser -D -u 10001 cashu-sync
COPY --from=build /out/cashu-sync-relay /usr/local/bin/cashu-sync-relay
USER cashu-sync
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/cashu-sync-relay"]
