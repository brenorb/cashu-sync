# Production: the TLS proxy is the only process allowed to reach this loopback port.
CASHU_SYNC_LISTEN_ADDR=127.0.0.1:3334
CASHU_SYNC_DB_PATH=./data/cashu-sync.db
CASHU_SYNC_MAX_HISTORY=8
CASHU_SYNC_ADMISSION_MODE=allowlist
CASHU_SYNC_SERVICE_URL=https://sync.example.com
CASHU_SYNC_ALLOWLIST_PATH=/etc/cashu-sync/allowed-pubkeys

# Local end-to-end tests may instead set admission mode to open. Open mode refuses
# wildcard, LAN, and public bind addresses.
# CASHU_SYNC_ADMISSION_MODE=open

# Demo-only public Fly deployment (unsafe; do not use for real funds):
# CASHU_SYNC_LISTEN_ADDR=0.0.0.0:8080
# CASHU_SYNC_ADMISSION_MODE=open
# CASHU_SYNC_DEMO_PUBLIC_OPEN=true
